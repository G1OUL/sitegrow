# ==============================================================================
# SiteGrow SaaS - Environment Configuration Template
# All variables are optional; defaults are configured for immediate local & Vercel deployment.
# NEVER commit real API keys, secrets, or .env files to version control.
# ==============================================================================

# Application Base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google PageSpeed Insights API key for real-user CrUX field data
# Leave blank to run in native automated crawler mode
PAGESPEED_API_KEY=your_optional_pagespeed_api_key_here

# Crawler Security & Engine Tuning
AUDIT_TIMEOUT_MS=8000
AUDIT_MAX_REDIRECTS=4
AUDIT_MAX_PAYLOAD_BYTES=2097152
AUDIT_USER_AGENT=Mozilla/5.0 (compatible; SiteGrowBot/1.0; +https://sitegrow.app)

